{
  "name": "gs-crawler",
  "version": "2.0.0",
  "description": "Multi-user GM data collector → AI analysis → daily report",
  "type": "commonjs",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node index.ts",
    "now": "ts-node index.ts --now",
    "auth:chat": "ts-node auth.ts --backend chat",
    "auth:recharge": "ts-node auth.ts --backend recharge",
    "install-browsers": "npx playwright install chromium"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "node-cron": "^3.0.3",
    "playwright": "^1.44.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/node-cron": "^3.0.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
